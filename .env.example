NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared Redis cache. Private runtime URL; never expose via NEXT_PUBLIC_.
REDIS_URL=
REDIS_CACHE_NAMESPACE=alisveris:public:v1
NEXT_PUBLIC_STORE_ROOT_DOMAIN=alisveris.az
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-supabase-project-id
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

SUPABASE_SECRET_KEY=your-server-only-supabase-service-role-key
# Alternative name supported by the app:
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key

# Cloudflare R2 image storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=alisverisaz-images
R2_PUBLIC_URL=https://images.alisveris.az

# Cloudflare Turnstile CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Auth email delivery is configured in Supabase Auth, not in the Next.js app.
# Transactional sender secrets belong to supabase/functions/email-dispatch/.env.example.
# Keep delivery disabled until the sender details are supplied.

# Telegram admin bot (server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_PASSWORD_HASH=
TELEGRAM_ADMIN_UNLOCK_CODE_HASH=

# Optional maintenance query for separate Cloud project; public key only.
SUPABASE_KEEPALIVE_ENABLED=false
SUPABASE_KEEPALIVE_URL=https://fxfycfkwodywmnzgkyvl.supabase.co
SUPABASE_KEEPALIVE_ANON_KEY=
SUPABASE_KEEPALIVE_STATE_FILE=/srv/alisveris/state/cloud-keepalive.json

# Enterprise security rollout: see docs/security/DEPLOYMENT.md before enabling.
# Set nginx only AFTER trusted real-IP overwrite and loopback ingress are verified.
TRUSTED_PROXY_MODE=
# Optional dedicated distributed limiter; otherwise uses REDIS_URL or migrated SQL RPC.
SECURITY_REDIS_URL=
TURNSTILE_ALLOWED_HOSTNAMES=alisveris.az
# Must match GoTrue CAPTCHA configuration. application alone does not protect direct Auth API.
AUTH_CAPTCHA_MODE=application
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Stage off -> enrolled -> required, coordinated with security_configuration DB flag.
ADMIN_MFA_POLICY=off
# Opt in only after TLS on every applicable subdomain is verified.
HSTS_INCLUDE_SUBDOMAINS=0

# RAdmin Danger mode: random server-only signing key, minimum 32 characters.
# Requires the existing private SECURITY_REDIS_URL and Turnstile configuration.
# Mode stays OFF until an AAL2 RAdmin explicitly enables it; expires in <= 6 hours.
DANGER_SIGNING_SECRET=

# Automatic Danger detection is opt-in through password-confirmed RAdmin; no cron/token is required.
# It shares the existing private Redis and signing configuration above.
