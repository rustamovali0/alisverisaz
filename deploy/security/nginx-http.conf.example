# http{} include. Review staging first. Cloudflare real_ip must be configured
# from maintained official CIDRs BEFORE using these client-IP limits.
map "$request_method:$uri" $security_auth_key {
 default "";
 ~^POST:/(?:az/|en/|ru/)?(?:login|register|forgot-password|radmin/login)$ $binary_remote_addr;
}
limit_req_zone $security_auth_key zone=security_auth:10m rate=60r/m;
map $uri $security_api_key { default ""; ~^/api/ $binary_remote_addr; }
map $uri $security_dynamic_key { default ""; ~^/(?:az/|en/|ru/)?(?:products|stores)(?:/|$) $binary_remote_addr; }
limit_req_zone $security_api_key zone=security_api:10m rate=240r/m;
limit_req_zone $security_dynamic_key zone=security_dynamic:10m rate=240r/m;
log_format security_json escape=json '{"time":"$time_iso8601","method":"$request_method","status":$status,"duration":$request_time}';
# Intentionally excludes URI/query/body/cookies/Authorization (recovery tokens).
